import java.util.*;

public class Solution {

```
public static long maximumSum(List<Long> a, long m) {
    TreeSet<Long> set = new TreeSet<>();
    long prefix = 0;
    long answer = 0;

    set.add(0L);

    for (long num : a) {
        prefix = (prefix + num % m) % m;

        answer = Math.max(answer, prefix);

        Long next = set.higher(prefix);

        if (next != null) {
            answer = Math.max(answer, (prefix - next + m) % m);
        }

        set.add(prefix);
    }

    return answer;
}

public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);

    int q = sc.nextInt();

    while (q-- > 0) {
        int n = sc.nextInt();
        long m = sc.nextLong();

        List<Long> a = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            a.add(sc.nextLong());
        }

        System.out.println(maximumSum(a, m));
    }

    sc.close();
}
